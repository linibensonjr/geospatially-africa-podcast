# Public browser-safe Supabase project URL (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Public browser-safe Supabase anonymous key (Project Settings → API).
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Canonical public site URL, without a trailing slash. Used by metadata,
# sitemap.xml, and robots.txt. Set this in Netlify too.
NEXT_PUBLIC_SITE_URL=https://geospatiallyafrica.com

# Optional privacy-friendly analytics (for example, Plausible or Umami).
# Leave blank to disable.
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Migration script only: the read-only source Heroku Postgres connection URL.
# Never expose this value in Netlify or any NEXT_PUBLIC_ variable.
HEROKU_DATABASE_URL=postgresql://...

# Migration script only: Supabase's direct/session-pooler Postgres connection
# URL from Project Settings → Database. Never expose this to the browser.
SUPABASE_DB_URL=postgresql://...
